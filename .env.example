POSTGRES_URL=
MP_ACCESS_TOKEN=
# Chave secreta gerada em Suas integrações > (sua aplicação) > Webhooks >
# Configurar notificação, no painel do Mercado Pago. Sem essa variável, o
# endpoint /api/mp-webhook ignora toda notificação recebida em vez de
# processar sem verificar a origem.
MP_WEBHOOK_SECRET=
# Credenciais OAuth2 do app cadastrado em https://melhorenvio.com.br (Meus
# Apps). O usuário conecta a conta clicando em "Conectar Melhor Envio" no
# painel /admin.html — o token de acesso fica salvo no banco, não aqui.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://vinho-harmonia.vercel.app/api/melhor-envio-callback
MELHOR_ENVIO_CEP_ORIGEM=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SITE_URL=https://vinho-harmonia.vercel.app
# PIX_KEY is documentation only, not read by any code: index.html is a static
# file with no server-side templating, so the PIX key is hardcoded directly in
# js/store.js (see Task 16). Update it in both places if it ever changes.
# PIX_KEY=contato@vinhoharmonia.com.br
